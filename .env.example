# ==============================================================================
# Shiuli CAD Studio - Frontend Environment Variables
# ==============================================================================
# Copy this file to .env and set your environment-specific values.
# NEVER commit .env to version control.

# --- API & Backend Connection ---
# Local development proxies /api/ via Vite to http://localhost:8000
VITE_API_BASE_URL=/api
# WebSocket URL for real-time notifications and staff job updates
VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws

# --- Razorpay Payment Gateway ---
# Use test key ('rzp_test_...') for staging/dev, live key ('rzp_live_...') for prod
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# --- Dev Email Simulation Credentials (Vite Dev Server Only) ---
# Used exclusively by the local development nodemailer middleware:
VITE_EMAIL_USER=your_dev_email@gmail.com
VITE_EMAIL_PASS=your_dev_app_password

# --- Environment Mode ---
# 'development' allows sandbox/test badges and dev logs; 'production' strictly enforces real transactions
VITE_APP_ENV=development
