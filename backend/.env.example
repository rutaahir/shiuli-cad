# ==============================================================================
# Shiuli CAD Studio - Backend Environment Variables
# ==============================================================================
# Copy this file to .env and set your environment-specific values.
# NEVER commit .env to version control.

# --- Core Deployment Flags ---
PRODUCTION=False
DEBUG=True
SECRET_KEY=django-insecure-change-me-to-a-random-50-character-secret-in-production
ALLOWED_HOSTS=*

# --- Database & Caching ---
# SQLite (Local Dev Default):
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (Production):
# DATABASE_URL=postgres://shiuli_user:shiuli_pass@postgres:5432/shiuli_db
# Redis (for Django Channels production workers):
# REDIS_URL=redis://redis:6379/1

# --- Production Security & Domains ---
# These are strictly enforced when PRODUCTION=True:
CORS_ALLOWED_ORIGINS=https://shiulicad.com,https://www.shiulicad.com
CSRF_TRUSTED_ORIGINS=https://shiulicad.com,https://www.shiulicad.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- SMTP Transactional Email (Gmail, Amazon SES, Sendgrid, etc.) ---
# In production, use your verified company SMTP credentials.
# NOTE: If using Gmail, generate a dedicated 16-character App Password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-support-or-orders-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Shiuli CAD Studio <orders@shiulicad.com>

# --- Razorpay Payment Gateway ---
# Use Test Key ('rzp_test_...') for Staging, Live Key ('rzp_live_...') for Production
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key

# --- DRF Rate Limiting / Abuse Prevention ---
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_AUTH_LOGIN=10/minute
THROTTLE_AUTH_OTP=5/minute
THROTTLE_PASSWORD_RESET=5/hour

# --- CAD Asset Storage (Local Disk vs Private Google Drive) ---
# Set to 'gdrive' to store and stream CAD files (.3dm, .stl, .zip) from Google Drive.
# Set to 'local' for local protected_media storage.
CAD_STORAGE_BACKEND=gdrive

# Target private Google Drive folder ID where all CAD assets reside:
GDRIVE_FOLDER_ID=your-google-drive-folder-id

# --- Method A: Personal Google Account OAuth 2.0 (Uses your 15 GB Personal Drive storage) ---
# 1. Path to your OAuth client JSON file:
GDRIVE_OAUTH_CLIENT_JSON_PATH=credentials/gdrive-oauth-client.json

# 2. Path to saved user credentials token (created by 'python backend/manage.py setup_gdrive_oauth'):
GDRIVE_USER_TOKEN_JSON_PATH=credentials/gdrive-user-token.json

# Optional: Alternatively configure via environment variables (e.g. on serverless/cloud hosting):
# GDRIVE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GDRIVE_OAUTH_CLIENT_SECRET=your-client-secret
# GDRIVE_REFRESH_TOKEN=1//your-oauth-refresh-token

# --- Method B: Google Workspace Service Account (Only for Google Workspace with Shared Drives) ---
# GDRIVE_SERVICE_ACCOUNT_JSON_PATH=credentials/gdrive-service-account.json
# GDRIVE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
